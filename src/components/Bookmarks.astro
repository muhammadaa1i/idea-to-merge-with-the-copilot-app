---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// Behavior: add, slug, persist (localStorage), copy and clear all live in the script below.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only, so localStorage is safe here.
  type Bookmark = { url: string; slug: string };

  const STORAGE_KEY = 'mona-bookmarks';
  const BASE62 = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list') as HTMLUListElement | null;
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  function loadBookmarks(): Bookmark[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item) => typeof item?.url === 'string' && typeof item?.slug === 'string');
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Storage can be full or blocked; the list still works for this visit.
    }
  }

  // Accepts "example.com" as well as full URLs, and only allows http(s) links.
  function parseUrl(value: string): string | null {
    const trimmed = value.trim();
    if (!trimmed) return null;
    const candidate = /^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
    try {
      const parsed = new URL(candidate);
      if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
      if (!parsed.hostname.includes('.') && parsed.hostname !== 'localhost') return null;
      return parsed.href;
    } catch {
      return null;
    }
  }

  // Short display alias: a base62 hash of the URL, lengthened until it is unique.
  function generateSlug(url: string, taken: Set<string>): string {
    let hash = 5381;
    for (const char of url) hash = ((hash * 33) ^ char.charCodeAt(0)) >>> 0;
    let code = '';
    do {
      code = BASE62[hash % 62] + code;
      hash = Math.floor(hash / 62);
    } while (hash > 0 && code.length < 4);
    let slug = `mona-${code.padStart(4, '0')}`;
    for (let counter = 1; taken.has(slug); counter++) slug = `mona-${code.padStart(4, '0')}${BASE62[counter % 62]}`;
    return slug;
  }

  function renderBookmark(bookmark: Bookmark): HTMLLIElement {
    const item = document.createElement('li');
    item.className = 'bookmark';

    const link = document.createElement('a');
    link.className = 'url';
    link.href = bookmark.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = bookmark.url;

    const badge = document.createElement('span');
    badge.className = 'slug';
    badge.textContent = bookmark.slug;

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'copy';
    copy.textContent = 'Copy';
    copy.setAttribute('aria-label', `Copy slug ${bookmark.slug}`);
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bookmark.slug);
        copy.textContent = 'Copied!';
      } catch {
        copy.textContent = 'Copy failed';
      }
      setTimeout(() => { copy.textContent = 'Copy'; }, 1500);
    });

    item.append(link, badge, copy);
    return item;
  }

  function render(bookmarks: Bookmark[]) {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren(...bookmarks.map(renderBookmark));
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;
  }

  let bookmarks = loadBookmarks();
  render(bookmarks);

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    if (!input) return;
    const url = parseUrl(input.value);
    if (!url) {
      input.setCustomValidity('Enter a valid web address, such as https://example.com');
      input.reportValidity();
      return;
    }
    const slug = generateSlug(url, new Set(bookmarks.map((bookmark) => bookmark.slug)));
    bookmarks = [{ url, slug }, ...bookmarks];
    saveBookmarks(bookmarks);
    render(bookmarks);
    form.reset();
    input.focus();
  });

  input?.addEventListener('input', () => input.setCustomValidity(''));

  clearAll?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Nothing to clear if storage is unavailable.
    }
    render(bookmarks);
  });
</script>
